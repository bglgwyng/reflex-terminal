cabal-version: 3.12
name: reflex-terminal
version: 0.1.0.0
-- synopsis:
-- description:
homepage: https://github.com/bglgwyng/reflex-terminal
license: MIT
license-file: LICENSE
author: bgl gwyng
maintainer: bgl@gwyng.com
-- copyright:
category: Graphics
build-type: Simple
extra-doc-files: CHANGELOG.md

-- extra-source-files:
common warnings
  ghc-options: -Wall

common languages
  default-language: GHC2024
  default-extensions:
    BlockArguments
    DerivingStrategies
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings, languages
  hs-source-dirs: lib
  exposed-modules:
    Reflex.Terminal.Image
    Reflex.Terminal.Interval
    Reflex.Terminal.Rect
    Reflex.Terminal.Style

  other-modules:
    Reflex.Terminal.Prelude

  other-extensions:
    TemplateHaskell

  build-depends:
    ansi-terminal,
    base ^>=4.20.2.0,
    lens,
    mtl,
    template-haskell,
    text ^>=2.1.4,
    wcwidth,

executable demo
  import: warnings, languages
  main-is: demo.hs
  -- other-modules:
  -- other-extensions:
  build-depends:
    ansi-terminal,
    base ^>=4.20.2.0,
    mtl,
    reflex-terminal,
    text ^>=2.1.4,

  hs-source-dirs: exe

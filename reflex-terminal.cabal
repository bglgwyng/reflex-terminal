cabal-version: 3.12
name: reflex-terminal
version: 0.1.0.0
-- synopsis:
-- description:
homepage: https://github.com/bglgwyng/reflex-terminal
license: MIT
license-file: LICENSE
author: bgl gwyng
maintainer: bgl@gwyng.com
-- copyright:
category: Graphics
build-type: Simple
extra-doc-files: CHANGELOG.md

-- extra-source-files:
common warnings
  ghc-options: -Wall

common languages
  default-language: GHC2024
  default-extensions:
    BlockArguments
    DerivingStrategies
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings, languages
  hs-source-dirs: lib
  exposed-modules:
    Reflex.Terminal.Host
    Reflex.Terminal.Image
    Reflex.Terminal.Interval
    Reflex.Terminal.Rect
    Reflex.Terminal.Style

  other-modules:
    Reflex.Terminal.Prelude

  other-extensions:
    TemplateHaskell

  build-depends:
    ansi-terminal,
    attoparsec,
    base ^>=4.20.2.0,
    bytestring,
    conduit,
    conduit-extra,
    containers,
    fingertree,
    lens,
    mtl,
    patch,
    reflex,
    reflex-terminal:terminal-input,
    some,
    template-haskell,
    terminal-size,
    text ^>=2.1.4,
    unix,
    wcwidth,

library terminal-input
  import: warnings, languages
  hs-source-dirs: terminal-input
  exposed-modules:
    Data.Conduit.Handle.Timeout
    System.Console.Input

  build-depends:
    attoparsec,
    base ^>=4.20.2.0,
    bytestring,
    conduit,
    conduit-extra,

executable demo
  import: warnings, languages
  main-is: demo.hs
  ghc-options:
    -threaded
    -rtsopts

  -- other-modules:
  -- other-extensions:
  build-depends:
    ansi-terminal,
    attoparsec,
    base ^>=4.20.2.0,
    bytestring,
    conduit,
    conduit-extra,
    constraints,
    containers,
    fingertree,
    mtl,
    reflex,
    reflex-terminal,
    reflex-terminal:terminal-input,
    some,
    text ^>=2.1.4,

  hs-source-dirs: exe

executable terminal-input-demo
  import: warnings, languages
  main-is: terminal-input-demo.hs
  ghc-options:
    -threaded
    -rtsopts

  build-depends:
    base ^>=4.20.2.0,
    bytestring,
    conduit,
    conduit-extra,
    reflex-terminal:terminal-input,

  hs-source-dirs: exe
